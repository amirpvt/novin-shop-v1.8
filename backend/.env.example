# Novin Shop Backend Environment
# این فایل را روی سرور به backend/.env کپی کنید و مقدارهای واقعی را جایگزین کنید.
# هرگز فایل واقعی .env را داخل ZIP/گیت تحویل ندهید.

# ─── Core ───────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_50_CHARS

# دامنه‌هایی که اجازه دارند Django را serve کنند
# مثال: ALLOWED_HOSTS=novindist.ir,www.novindist.ir,SERVER_IP
ALLOWED_HOSTS=novindist.ir,www.novindist.ir

# آدرس عمومی Frontend؛ برای callback پرداخت زرین‌پال استفاده می‌شود
FRONTEND_URL=https://novindist.ir

# ─── Database / PostgreSQL ──────────────────────────────────────────────
# در Production فقط PostgreSQL مجاز است. SQLite فقط برای Development است.
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://novin_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/novin_shop
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# ─── CORS / CSRF ────────────────────────────────────────────────────────
# در Production نباید همه originها باز باشند.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://novindist.ir,https://www.novindist.ir
CSRF_TRUSTED_ORIGINS=https://novindist.ir,https://www.novindist.ir

# ─── HTTPS Security Headers ─────────────────────────────────────────────
# اگر پشت Nginx/Proxy با SSL هستید، این تنظیمات مناسب Production است.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ─── Zarinpal / Payment ─────────────────────────────────────────────────
# Production: Merchant واقعی + Sandbox خاموش
ZARINPAL_MERCHANT_ID=CHANGE_ME_REAL_MERCHANT_ID
ZARINPAL_SANDBOX=False
ZARINPAL_REQUEST_TIMEOUT=10
