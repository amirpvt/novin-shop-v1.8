# Novin Shop backend environment
# Copy this file to backend/.env on the server and change values.

DEBUG=False
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY

# Domains/IPs that may serve Django
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,SERVER_IP

# Frontend origins allowed to call the API
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# PostgreSQL
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://novin_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/novin_shop
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Frontend URL used for payment callback generation
FRONTEND_URL=https://your-domain.com

# Zarinpal / payment
ZARINPAL_MERCHANT_ID=CHANGE_ME
ZARINPAL_SANDBOX=False
